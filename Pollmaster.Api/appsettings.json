{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gios": {
    "BaseAddress": "https://api.gios.gov.pl/",
    "TimeoutSeconds": 30,
    "Cache": {
      "StationsTtlMinutes": 120,
      "SensorsTtlMinutes": 60,
      "IndexTtlSeconds": 900,
      "MeasurementsTtlSeconds": 900,
      "SnapshotTtlSeconds": 900
    }
  },
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  "Warmup": {
    "Enabled": true,
    "InitialDelaySeconds": 5,
    "IntervalSeconds": 600
  }
}
