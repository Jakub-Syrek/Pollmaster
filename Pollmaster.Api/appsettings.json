{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gios": {
    "BaseAddress": "https://api.gios.gov.pl/",
    "TimeoutSeconds": 30,
    "Cache": {
      "StationsTtlMinutes": 60,
      "SensorsTtlMinutes": 30,
      "IndexTtlSeconds": 300,
      "MeasurementsTtlSeconds": 300,
      "SnapshotTtlSeconds": 300
    }
  },
  "Cors": {
    "AllowedOrigins": [ "*" ]
  }
}
