<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Pollmaster.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.17.0</Version>
    <UserSecretsId>pollmaster-api-bf18d4</UserSecretsId>
    <Authors>Jakub Syrek</Authors>
    <Company>Jakub Syrek</Company>
    <Product>Pollmaster API</Product>
    <Description>ASP.NET Core 10 backend for Pollmaster. Aggregates Polish GIOS ground-station readings with Copernicus CAMS and OpenWeatherMap satellite-assimilated forecasts behind a Strategy-pattern provider chain. Stale-while-revalidate cache (memory + disk), background warmup, sliding-window rate limiter, resilience pipeline and structured health checks.</Description>
    <PackageProjectUrl>https://github.com/Jakub-Syrek/Pollmaster</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Jakub-Syrek/Pollmaster</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) Jakub Syrek</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pollmaster.Shared\Pollmaster.Shared.csproj" />
  </ItemGroup>

</Project>
