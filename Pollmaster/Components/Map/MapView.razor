@using System.Threading
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using Pollmaster.Services
@using Pollmaster.Shared.Common
@using Pollmaster.Shared.Contracts
@implements IAsyncDisposable
@inject IPollmasterApiClient ApiClient
@inject IMediaCaptureService CaptureService
@inject IOfflineOverviewCache OfflineCache
@inject ILogger<MapView> Logger
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<Pollmaster.Configuration.ApiClientOptions> ApiOptions

<div class="map-page">
    <header class="map-page__header">
        <h2>Pollmaster — Polish air-quality map</h2>
        <div class="map-page__actions">
            <button type="button" class="map-page__btn"
                    @onclick="OnRefreshClickedAsync"
                    disabled="@_refreshing">@(_refreshing ? "Refreshing…" : "Refresh")</button>
            <button type="button" class="map-page__btn map-page__btn--center"
                    @onclick="OnCenterClickedAsync"
                    disabled="@_busy"
                    title="Centre the map on your current location">Center</button>
            <button type="button" class="map-page__btn"
                    @onclick="OnScreenshotClickedAsync"
                    disabled="@_busy">Screenshot</button>
            @if (_recordingSessionId is null)
            {
                <button type="button" class="map-page__btn"
                        @onclick="OnStartRecordingClickedAsync"
                        disabled="@_busy">Record</button>
            }
            else
            {
                <button type="button" class="map-page__btn map-page__btn--recording"
                        @onclick="OnStopRecordingClickedAsync"
                        disabled="@_busy">Stop</button>
            }
        </div>
        <span class="map-page__status">@_status</span>
    </header>
    <div class="map-page__container">
        <div id="pollmaster-map" @ref="_mapElement"></div>
    </div>
</div>

@code {
    private const string MapContainerElementId = "pollmaster-map";

    // Screenshot uses native retina-grade oversampling (2x). The map renders at CSS
    // resolution; html2canvas multiplies that by ScreenshotScale before rasterising.
    private const double ScreenshotScale = 2.0;

    // Recording knobs — chosen so the 8 fps loop stays inside the CPU budget on an
    // Android phone while still producing a noticeably smoother result than the original
    // 4 fps capture. Bitrate is generous (6 Mbps) so the VP8/VP9 encoder does not chew
    // detail away from the marker overlays.
    private const int RecordingFps = 8;
    private const double RecordingScale = 1.5;
    private const int RecordingBitsPerSecond = 6_000_000;

    // Poll cadence for /api/overview/quick during a cold backend warmup. Tight enough
    // that markers visibly pop in (3 s ~= 60 stations per poll given GIOS rate-limit
    // throughput), loose enough to not chew Railway egress credits.
    private const int OverviewPollIntervalMs = 3000;
    // Hard ceiling on the progressive-poll loop. After this we stop polling regardless
    // of completion - prevents an indefinite spinner if the backend wedges.
    private const int OverviewPollTimeoutSeconds = 240;

    private ElementReference _mapElement;
    private DotNetObjectReference<MapView>? _dotnetRef;
    private string _status = "Initializing...";
    private bool _initialized;
    // Locks Screenshot/Record/Center - these share the WebView during capture and must
    // not interleave. NOT set during overview refresh so the user can still capture or
    // jump to their location while the markers are populating.
    private bool _busy;
    // Debounces the Refresh button itself so a second click does not spawn a parallel
    // poll loop. Independent of `_busy` so it never blocks the other action buttons.
    private bool _refreshing;
    private string? _recordingSessionId;
    private readonly CancellationTokenSource _cts = new();

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
        {
            return;
        }

        _initialized = true;

        // Step 1: spin up Leaflet inside the WebView. Narrowly scoped try/catch so the
        // "Map init failed" status only fires when the JS map actually fails - not when
        // an unrelated overview poll throws much later.
        try
        {
            _dotnetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pollmasterMap.initMap", "pollmaster-map", _dotnetRef);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "pollmasterMap.initMap failed");
            _status = $"Map init failed: {ex.GetType().Name}: {ex.Message}";
            StateHasChanged();
            return;
        }

        // Step 2: progressive overview load. Lights up the Refresh button so the user
        // sees something is happening even on the very first open.
        _refreshing = true;
        StateHasChanged();
        try
        {
            await LoadOverviewAsync(_cts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Initial overview load failed");
            _status = $"Initial load failed: {ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _refreshing = false;
            StateHasChanged();
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_recordingSessionId is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("pollmasterCapture.abortRecording", _recordingSessionId);
            }
            catch
            {
                // WebView may already be torn down.
            }
            _recordingSessionId = null;
        }
        try
        {
            await JS.InvokeVoidAsync("pollmasterMap.dispose");
        }
        catch
        {
            // WebView may already be torn down.
        }
        _dotnetRef?.Dispose();
        _cts.Dispose();
    }

    private async Task LoadOverviewAsync(CancellationToken cancellationToken)
    {
        // Surface the resolved BaseAddress everywhere so a misconfigured APK is obvious in
        // both the UI and adb logcat. Once burned twice shy on the appsettings packaging.
        var baseAddress = ApiOptions.Value.BaseAddress ?? "(null)";
        Logger.LogInformation("Pollmaster client BaseAddress: {BaseAddress}", baseAddress);
        var host = DisplayHost(baseAddress);

        // Stage 1 — instant render from the on-device snapshot, if we have one.
        // Lets the user see the map populated within ~50 ms of opening the app, even
        // when the backend is asleep, cold-starting on a free tier, or the phone is
        // offline.
        var offline = await OfflineCache.LoadAsync(cancellationToken);
        var lastRenderedCount = 0;
        if (offline is not null && offline.Stations.Count > 0)
        {
            var cachedMarkers = offline.Stations.Select(ToMarker).ToArray();
            await JS.InvokeVoidAsync("pollmasterMap.addStations", (object)cachedMarkers);
            lastRenderedCount = cachedMarkers.Length;
            var age = DateTime.UtcNow - offline.SavedAt;
            _status = $"Offline cache: {cachedMarkers.Length} stations · {FormatAge(age)} old · refreshing from {host}…";
            StateHasChanged();
        }
        else
        {
            _status = $"Loading from {host}…";
            StateHasChanged();
        }

        // Stage 2 — progressive poll against /api/overview/quick. The endpoint is
        // non-blocking on the server: it returns whatever the in-memory cache holds at
        // the moment, including a partial view during a cold warmup. We render markers
        // as soon as each batch arrives so the user sees Poland fill up rather than
        // stare at a blank map for the 5-10 minutes of an upstream GIOS fan-out.
        var startedAt = DateTime.UtcNow;
        IReadOnlyList<StationOverviewDto>? finalSet = null;
        while (!cancellationToken.IsCancellationRequested &&
               (DateTime.UtcNow - startedAt).TotalSeconds < OverviewPollTimeoutSeconds)
        {
            var poll = await ApiClient.GetOverviewQuickAsync(cancellationToken);
            if (poll.IsFailure)
            {
                _status = offline is not null
                    ? $"Offline · {host} unreachable ({poll.Error}). Showing cached snapshot."
                    : $"Backend error ({host}): {poll.Error}";
                StateHasChanged();
                return;
            }

            var partial = poll.Value;
            if (partial.Stations.Count > lastRenderedCount || partial.IsComplete)
            {
                // New stations arrived since the last poll - re-render the marker layer.
                // map.js clears + re-adds in addStations, so this is idempotent and the
                // user just sees more pins each tick.
                var markers = partial.Stations.Select(ToMarker).ToArray();
                await JS.InvokeVoidAsync("pollmasterMap.addStations", (object)markers);
                lastRenderedCount = markers.Length;

                if (partial.IsComplete)
                {
                    _status = $"{markers.Length} stations loaded";
                    finalSet = partial.Stations;
                    break;
                }
                _status = partial.TotalExpected > 0
                    ? $"Loading from {host}: {markers.Length} / {partial.TotalExpected} stations…"
                    : $"Loading from {host}: {markers.Length} stations…";
                StateHasChanged();
            }
            else if (partial.Stations.Count == 0)
            {
                // Backend is cold-starting and has not begun publishing the partial yet.
                _status = $"Backend warming up ({host}) — first stations any moment…";
                StateHasChanged();
            }

            try
            {
                await Task.Delay(OverviewPollIntervalMs, cancellationToken);
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }

        if (finalSet is not null)
        {
            // Persist asynchronously — don't make the UI wait for IO.
            _ = OfflineCache.SaveAsync(finalSet, _cts.Token);
        }
        else if (lastRenderedCount > 0)
        {
            // Polling timed out but we did render something incremental. Leave the last
            // partial on the map and tell the user.
            _status = $"Stopped polling after {OverviewPollTimeoutSeconds}s · {lastRenderedCount} stations shown (partial).";
            StateHasChanged();
        }
    }

    private static string FormatAge(TimeSpan age)
    {
        if (age.TotalMinutes < 1) return "<1 min";
        if (age.TotalMinutes < 60) return $"{(int)age.TotalMinutes} min";
        if (age.TotalHours < 24) return $"{age.TotalHours:F1} h";
        return $"{(int)age.TotalDays} d";
    }

    private static string DisplayHost(string baseAddress)
    {
        // Strip scheme + trailing slash for compact status-line display.
        if (string.IsNullOrEmpty(baseAddress) || baseAddress == "(null)")
        {
            return "(unset)";
        }
        if (Uri.TryCreate(baseAddress, UriKind.Absolute, out var uri))
        {
            return uri.IsDefaultPort ? uri.Host : $"{uri.Host}:{uri.Port}";
        }
        return baseAddress.Trim('/');
    }

    private async Task OnRefreshClickedAsync()
    {
        // Refresh has its own debounce flag - it does not lock Screenshot/Record/Center
        // so the user can keep using the app while station data is repopulating from a
        // cold backend.
        if (_refreshing)
        {
            return;
        }
        _refreshing = true;
        StateHasChanged();
        try
        {
            await LoadOverviewAsync(_cts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Refresh failed");
            _status = $"Refresh failed: {ex.Message}";
        }
        finally
        {
            _refreshing = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Centre the Leaflet map on the device's current location. Uses MAUI Essentials
    /// <see cref="Microsoft.Maui.Devices.Sensors.Geolocation"/> rather than the
    /// in-WebView HTML5 navigator.geolocation: native API bypasses the WebView
    /// permissions prompt plumbing (which is fiddly on Android Blazor Hybrid) and
    /// gives us a clean PermissionStatus value to surface in the status line.
    /// </summary>
    private async Task OnCenterClickedAsync()
    {
        if (_busy)
        {
            return;
        }
        await RunCaptureAsync(async () =>
        {
            _status = "Requesting location permission…";
            StateHasChanged();

            var permission = await Permissions.CheckStatusAsync<Permissions.LocationWhenInUse>();
            if (permission != PermissionStatus.Granted)
            {
                permission = await Permissions.RequestAsync<Permissions.LocationWhenInUse>();
            }
            if (permission != PermissionStatus.Granted)
            {
                _status = "Location permission denied — cannot centre the map.";
                StateHasChanged();
                return;
            }

            _status = "Locating…";
            StateHasChanged();

            // Medium accuracy ≈ 100 m city block, plenty for a map pan and ~2× faster
            // than High (which spins up the GPS chip). 10 s timeout keeps the UI from
            // hanging indefinitely if the user is indoors / no fix.
            var request = new GeolocationRequest(GeolocationAccuracy.Medium, TimeSpan.FromSeconds(10));
            var location = await Geolocation.Default.GetLocationAsync(request, _cts.Token);
            if (location is null)
            {
                _status = "Could not determine your location.";
                StateHasChanged();
                return;
            }

            await JS.InvokeVoidAsync(
                "pollmasterMap.centerOnLocation",
                _cts.Token,
                location.Latitude,
                location.Longitude,
                location.Accuracy ?? 0);
            _status = $"Centred on ({location.Latitude:F4}, {location.Longitude:F4}).";
        }, failureStatus: "Center failed.");
    }

    private async Task OnScreenshotClickedAsync()
    {
        if (_busy)
        {
            return;
        }
        await RunCaptureAsync(async () =>
        {
            _status = "Capturing screenshot...";
            StateHasChanged();
            var dataUri = await JS.InvokeAsync<string>(
                "pollmasterCapture.captureScreenshot", _cts.Token, MapContainerElementId, ScreenshotScale);
            await CaptureService.SaveAndShareAsync(dataUri, ".png", "Pollmaster screenshot");
            _status = "Screenshot ready — share sheet opened.";
        }, failureStatus: "Screenshot failed.");
    }

    private async Task OnStartRecordingClickedAsync()
    {
        if (_busy || _recordingSessionId is not null)
        {
            return;
        }
        _busy = true;
        try
        {
            _status = $"Starting recording at {RecordingFps} fps ({RecordingScale}x)...";
            StateHasChanged();
            _recordingSessionId = await JS.InvokeAsync<string>(
                "pollmasterCapture.startRecording",
                _cts.Token,
                MapContainerElementId,
                RecordingFps,
                RecordingScale,
                RecordingBitsPerSecond);
            _status = "Recording — tap Stop when done.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Start recording failed");
            _status = $"Recording failed: {ex.Message}";
            _recordingSessionId = null;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task OnStopRecordingClickedAsync()
    {
        var sessionId = _recordingSessionId;
        if (_busy || sessionId is null)
        {
            return;
        }
        await RunCaptureAsync(async () =>
        {
            _status = "Finalising recording...";
            StateHasChanged();
            var dataUri = await JS.InvokeAsync<string>(
                "pollmasterCapture.stopRecording", _cts.Token, sessionId);
            _recordingSessionId = null;
            await CaptureService.SaveAndShareAsync(dataUri, ".webm", "Pollmaster screen recording");
            _status = "Recording ready — share sheet opened.";
        }, failureStatus: "Recording could not be saved.");
    }

    private async Task RunCaptureAsync(Func<Task> work, string failureStatus)
    {
        _busy = true;
        StateHasChanged();
        try
        {
            await work();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{Status}", failureStatus);
            _status = $"{failureStatus} ({ex.Message})";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Invoked from JS when the user clicks an empty area of the map. Hits the satellite
    /// endpoint and pushes the resulting reading back into the open probe popup. Failures
    /// land as a "satellite data unavailable" message instead of crashing the JS layer.
    /// </summary>
    /// <param name="latitude">Clicked WGS84 latitude.</param>
    /// <param name="longitude">Clicked WGS84 longitude.</param>
    [JSInvokable]
    public async Task OnMapClickedAsync(double latitude, double longitude)
    {
        try
        {
            var result = await ApiClient.GetSatellitePointAsync(latitude, longitude, _cts.Token);
            object? payload = result.IsSuccess ? result.Value : null;
            await JS.InvokeVoidAsync("pollmasterMap.setSatelliteReading", payload);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Satellite point fetch failed");
            try
            {
                await JS.InvokeVoidAsync("pollmasterMap.setSatelliteReading", (object?)null);
            }
            catch
            {
                // WebView may already be torn down.
            }
        }
    }

    private static MapMarker ToMarker(StationOverviewDto overview)
    {
        var pollutants = overview.Pollutants
            .Select(p => new MapMarkerPollutant(p.Code, p.Value, p.Ratio))
            .ToArray();

        return new MapMarker(
            Id: overview.Id,
            Name: overview.Name,
            City: overview.City,
            Latitude: overview.Latitude,
            Longitude: overview.Longitude,
            Severity: (int)overview.Severity,
            CriticalCode: overview.CriticalCode,
            Pollutants: pollutants);
    }
}
